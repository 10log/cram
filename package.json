{
  "name": "cram",
  "version": "0.2.1",
  "license": "MIT",
  "repository": {
    "url": "https://github.com/gregzanch/cram.git"
  },
  "description": "interface for computational room acoustics",
  "keywords": [
    "acoustics",
    "computation",
    "ray-tracing",
    "image-source",
    "fdtd"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/src/lib/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/src/lib/index.d.ts"
    },
    "./styles": {
      "import": "./dist/styles.js",
      "types": "./dist/src/css/index.d.ts"
    },
    "./dist/cram.ui.css": "./dist/cram.ui.css"
  },
  "files": [
    "dist",
    "src/lib",
    "src/css",
    "src/store",
    "src/objects",
    "src/compute"
  ],
  "scripts": {
    "dev": "vite",
    "start": "vite",
    "build": "vite build",
    "prebuild:jscad": "node scripts/prebundle-jscad.mjs",
    "build:lib": "npm run prebuild:jscad && vite build --mode lib",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "test:perf": "vitest run --testNamePattern=perf",
    "test:perf:update-baseline": "cross-env UPDATE_PERF_BASELINE=1 npm run test:perf",
    "lint": "eslint src/",
    "lint:types": "tsc --noEmit",
    "test:e2e": "npx playwright test",
    "test:e2e:update": "npx playwright test --update-snapshots",
    "test:e2e:ui": "npx playwright test --ui",
    "test:e2e:report": "npx playwright show-report"
  },
  "dependencies": {
    "@babel/runtime": "^8.0.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^9.0.1",
    "@mui/material": "^9.0.1",
    "@mui/x-tree-view": "^9.1.0",
    "@types/d3": "^7.4.3",
    "@types/plotly.js": "^3.0.9",
    "@types/zip.js": "^2.0.28",
    "@visx/axis": "^4.0.0",
    "@visx/gradient": "^4.0.0",
    "@visx/grid": "^4.0.0",
