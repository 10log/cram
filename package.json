    "immer": "^11.1.0",
    "lodash": "^4.17.21",
    "normalize.css": "^8.0.1",
    "object-hash": "^3.0.0",
    "plotly.js": "^3.5.0",
    "react-app-polyfill": "^3.0.0",
    "react-color": "^2.18.0",
    "react-dev-utils": "^12.0.1",
    "react-select": "^5.10.2",
    "react-tabs": "^6.1.0",
    "react-window": "^2.2.3",
    "semver": "^7.6.3",
    "simple-statistics": "^7.1.0",
    "three": "^0.185.0",
    "three-mesh-bvh": "^0.9.9",
    "three.meshline": "^1.4.0",
    "uplot": "^1.0.8",
    "uuid": "^14.0.0",
    "zustand": "^5.0.9"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@babel/core": "^8.0.1",
    "@babel/preset-env": "^8.0.2",
