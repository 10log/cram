{
  "name": "cram",
  "version": "0.2.1",
  "license": "MIT",
  "repository": {
    "url": "https://github.com/gregzanch/cram.git"
  },
  "description": "interface for computational room acoustics",
  "keywords": [
    "acoustics",
    "computation",
    "ray-tracing",
    "image-source",
    "fdtd"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/src/lib/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/src/lib/index.d.ts"
    },
    "./styles": {
      "import": "./dist/styles.js",
      "types": "./dist/src/css/index.d.ts"
    },
    "./dist/cram.ui.css": "./dist/cram.ui.css"
  },
  "files": [
    "dist",
    "src/lib",
    "src/css",
    "src/store",
    "src/objects",
    "src/compute"
  ],
  "scripts": {
    "dev": "vite",
    "start": "vite",
    "build": "vite build",
    "prebuild:jscad": "node scripts/prebundle-jscad.mjs",
    "build:lib": "npm run prebuild:jscad && vite build --mode lib",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "test:perf": "vitest run --testNamePattern=perf",
    "test:perf:update-baseline": "cross-env UPDATE_PERF_BASELINE=1 npm run test:perf",
    "lint": "eslint src/",
    "lint:types": "tsc --noEmit",
    "test:e2e": "npx playwright test",
    "test:e2e:update": "npx playwright test --update-snapshots",
    "test:e2e:ui": "npx playwright test --ui",
    "test:e2e:report": "npx playwright show-report"
  },
  "dependencies": {
    "@babel/runtime": "^8.0.7",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^9.5.0",
    "@mui/material": "^9.5.0",
    "@mui/x-tree-view": "^9.15.0",
    "@types/d3": "^7.4.3",
    "@types/plotly.js": "^3.0.15",
    "@visx/axis": "^4.0.0",
    "@visx/grid": "^4.0.0",
    "@visx/group": "^4.0.0",
    "@visx/legend": "^4.0.0",
    "@visx/responsive": "^4.0.0",
    "@visx/scale": "^4.0.0",
    "@visx/shape": "^4.0.0",
    "ambisonics": "github:10log/TSAmbisonics",
    "beam-trace": "github:10log/BeamTrace2D#master",
    "chroma-js": "^3.2.0",
    "d3": "^7.9.0",
    "dxf-parser": "^1.1.2",
    "fast-fuzzy": "^1.12.0",
    "file-saver": "^2.0.5",
    "flexlayout-react": "^0.11.1",
    "hotkeys-js": "^4.0.8",
    "immer": "^11.1.21",
    "lodash": "^4.18.1",
    "meshline": "^3.3.1",
    "normalize.css": "^8.0.1",
    "object-hash": "^3.0.0",
    "react-app-polyfill": "^3.0.0",
    "react-dev-utils": "^12.0.1",
    "react-window": "^2.3.4",
    "semver": "^7.8.5",
    "simple-statistics": "^7.12.1",
    "three": "^0.186.1",
    "three-mesh-bvh": "^0.9.16",
    "uuid": "^14.0.3",
    "zustand": "^5.0.15"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@babel/core": "^8.0.7",
    "@babel/preset-env": "^8.0.7",
    "@babel/preset-react": "^8.0.1",
    "@babel/preset-typescript": "^8.0.7",
    "@eslint/js": "^10.0.1",
    "@jscad/modeling": "^2.13.0",
    "@microsoft/api-extractor": "^7.59.4",
    "@playwright/test": "^1.64.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/chroma-js": "^3.1.2",
    "@types/file-saver": "^2.0.7",
    "@types/lodash": "^4.17.26",
    "@types/node": "^26.6.5",
    "@types/object-hash": "^3.0.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/semver": "^7.8.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.3",
    "@vitest/ui": "^5.0.3",
    "@webgpu/types": "^0.1.74",
    "babel-preset-react-app": "^10.1.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.12.0",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-unused-imports": "^4.4.1",
    "fast-check": "^4.10.2",
    "fs-extra": "^11.4.1",
    "globals": "^17.13.0",
    "jsdom": "^30.1.2",
    "postcss": "^8.5.29",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-is": "^19.3.0",
    "resolve": "^1.22.13",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.4",
    "vite-plugin-dts": "^5.1.2",
    "vitest": "^5.0.3"
  },
  "browserslist": [
    ">0.2%",
    "not dead",
    "not ie <= 11",
    "not op_mini all"
  ],
  "babel": {
    "presets": [
      "react-app"
    ]
  }
}
