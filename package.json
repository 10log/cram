    "@visx/legend": "^4.0.0",
    "@visx/responsive": "^4.0.0",
    "@visx/scale": "^4.0.0",
    "@visx/shape": "^4.0.0",
    "@visx/zoom": "^4.0.0",
    "@zip.js/zip.js": "^2.2.23",
    "ambisonics": "github:10log/TSAmbisonics",
    "beam-trace": "github:10log/BeamTrace2D#master",
    "chroma-js": "^3.2.0",
    "d3": "^7.9.0",
    "dxf-parser": "^1.0.0-alpha.2",
    "es-abstract": "^1.24.1",
    "fast-fuzzy": "^1.9.1",
    "fast-sort": "^3.4.1",
    "file-saver": "^2.0.2",
    "flexlayout-react": "^0.10.0",
