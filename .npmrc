engine-strict=false
loglevel=error
# React 19: @visx/* 3.12 still declares a react ^16||^17||^18 peer range (no
# React 19 release yet) even though it runs fine under React 19. Relax peer
# resolution so installs (and CI) don't ERESOLVE. Remove once @visx ships
# React 19 peer support.
legacy-peer-deps=true
